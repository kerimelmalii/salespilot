# Bu dosyayı .env.local olarak kopyalayın ve gerçek key'lerinizi girin.
# .env.local ASLA git'e commit edilmemeli (bkz. .gitignore).

# https://serper.dev üzerinden alınır
SERPER_API_KEY=

# https://console.anthropic.com üzerinden alınır
ANTHROPIC_API_KEY=

# Deploy edildiğinde siteye giriş için paylaşılan şifre (MVP1 geçici koruma).
# Kendiniz belirleyin, kimseyle paylaşmayın (pilot şirketlere ayrı vereceksiniz).
SITE_PASSWORD=

# Rastgele, uzun bir metin - cookie imzalamak için kullanılır, kimseyle
# paylaşmayın. Örn: openssl rand -hex 32 komutuyla üretebilirsiniz.
SESSION_SECRET=
