# Bu dosyayı .env.local olarak kopyalayın ve gerçek key'lerinizi girin.
# .env.local ASLA git'e commit edilmemeli (bkz. .gitignore).

# https://serper.dev üzerinden alınır
SERPER_API_KEY=

# https://console.anthropic.com üzerinden alınır
ANTHROPIC_API_KEY=

# Deploy edildiğinde siteye giriş için paylaşılan şifre (MVP1 geçici koruma).
# Kendiniz belirleyin, kimseyle paylaşmayın (pilot şirketlere ayrı vereceksiniz).
SITE_PASSWORD=

# Rastgele, uzun bir metin - cookie imzalamak için kullanılır, kimseyle
# paylaşmayın. Örn: openssl rand -hex 32 komutuyla üretebilirsiniz.
SESSION_SECRET=

# --- Mail gönderimi (Faz 5) ---

# Gmail hesabınız (gönderen adres). 2FA açık olmalı.
GMAIL_USER=

# Normal Gmail şifreniz DEĞİL - myaccount.google.com/apppasswords adresinden
# üretilen 16 haneli "Uygulama Şifresi". Normal şifrenizi asla buraya yazmayın.
GMAIL_APP_PASSWORD=

# GÜVENLİK: "false" yazılmadığı sürece test modu AÇIK sayılır - tüm
# göndermeler gerçek şirket yerine TEST_EMAIL_RECIPIENT'e gider. Pilot
# şirketlere gerçekten göndermeye hazır olana kadar bunu "false" YAPMAYIN.
TEST_EMAIL_MODE=true

# Test modundayken tüm maillerin gerçekte gideceği adres (kendi mailiniz).
TEST_EMAIL_RECIPIENT=
